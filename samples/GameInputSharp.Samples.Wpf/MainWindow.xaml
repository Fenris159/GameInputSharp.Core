<Window x:Class="GameInputSharp.Samples.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameInputSharp.Samples.Wpf" Height="400" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Button x:Name="RefreshButton" Content="Refresh devices" Click="RefreshButton_Click" Padding="8,4" Margin="0,0,0,8"/>
        <ListBox x:Name="DeviceList" Grid.Row="1" Margin="0,0,0,8"/>
        <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" FontSize="12" Foreground="Gray"/>
    </Grid>
</Window>
